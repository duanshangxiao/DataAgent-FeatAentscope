# Copy this file to .env and fill in local-only values. Never commit real credentials.
DATA_AGENT_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3360/feat-agentscope?useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&transformedBitIsBoolean=true&allowMultiQueries=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai'
DATA_AGENT_DATASOURCE_USERNAME='root'
DATA_AGENT_DATASOURCE_PASSWORD=''

# never: do not run schema.sql/data.sql (recommended for normal local development)
# always: run schema.sql followed by data.sql on every startup (fresh disposable databases only)
DATA_AGENT_DATASOURCE_SQL_INIT='never'

# 向量库后端：elasticsearch（默认）或 pgvector。
DATA_AGENT_VECTORSTORE_TYPE='elasticsearch'
DATA_AGENT_VECTORSTORE_DIMENSIONS='1024'

# Elasticsearch 示例；启用认证时再填写用户名和密码。
SPRING_ELASTICSEARCH_URIS='http://127.0.0.1:9200'
SPRING_ELASTICSEARCH_USERNAME=''
SPRING_ELASTICSEARCH_PASSWORD=''

# PGVector 示例；DATA_AGENT_VECTORSTORE_TYPE=pgvector 时生效。
# 对应镜像示例：pgvector/pgvector:pg16-bookworm。
DATA_AGENT_VECTORSTORE_URL='jdbc:postgresql://127.0.0.1:5432/vector_db_feat?currentSchema=public&ApplicationName=data-agent-vectorstore&tcpKeepAlive=true&connectTimeout=10&socketTimeout=30'
DATA_AGENT_VECTORSTORE_USERNAME='data_agent'
DATA_AGENT_VECTORSTORE_PASSWORD=''
DATA_AGENT_VECTORSTORE_SCHEMA='public'
DATA_AGENT_VECTORSTORE_TABLE='cares_data_agent_weihai'

# Vite 开发代理。
VITE_BACKEND_TARGET='http://127.0.0.1:8065'

# Optional metric capability endpoints.
SPRING_AI_ALIBABA_DATA_AGENT_CAPABILITIES_METRIC_SYSTEM_ENABLED='true'
DATA_AGENT_METRIC_PARSER_FORMAT='openapi3'
DATA_AGENT_METRIC_SWAGGER_URL='http://127.0.0.1:8081/v3/api-docs/metric'
DATA_AGENT_METRIC_BASE_URL='http://127.0.0.1:8081'
SPRING_AI_ALIBABA_DATA_AGENT_CAPABILITIES_METRIC_SYSTEM_REFRESH_INTERVAL_SECONDS='1800'
SPRING_AI_ALIBABA_DATA_AGENT_CAPABILITIES_METRIC_SYSTEM_TIMEOUT_MS='10000'
DATA_AGENT_METRIC_MAX_RESPONSE_BYTES='262144'
DATA_AGENT_METRIC_MAX_RESULT_ROWS='200'

# Optional observability. Keep secrets empty unless Langfuse is enabled.
LANGFUSE_ENABLED='false'
LANGFUSE_HOST=''
LANGFUSE_PUBLIC_KEY=''
LANGFUSE_SECRET_KEY=''
AGENTSCOPE_OBSERVABILITY_ENABLED='true'
AGENTSCOPE_OBSERVABILITY_USE_LANGFUSE_TRACER='true'
