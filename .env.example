# Copy this file to .env and fill in local-only values. Never commit real credentials.
DATA_AGENT_DATASOURCE_URL='jdbc:mysql://127.0.0.1:3360/feat-agentscope?useUnicode=true&characterEncoding=utf-8&zeroDateTimeBehavior=convertToNull&transformedBitIsBoolean=true&allowMultiQueries=true&allowPublicKeyRetrieval=true&useSSL=false&serverTimezone=Asia/Shanghai'
DATA_AGENT_DATASOURCE_USERNAME='root'
DATA_AGENT_DATASOURCE_PASSWORD=''

# never: do not run schema.sql/data.sql (recommended for normal local development)
# always: run schema.sql followed by data.sql on every startup (fresh disposable databases only)
DATA_AGENT_DATASOURCE_SQL_INIT='never'

# Default vector store and Vite development proxy.
SPRING_ELASTICSEARCH_URIS='http://127.0.0.1:9200'
VITE_BACKEND_TARGET='http://127.0.0.1:8065'

# Optional metric capability endpoints.
DATA_AGENT_METRIC_SWAGGER_URL='http://127.0.0.1:8081/v3/api-docs/metric'
DATA_AGENT_METRIC_BASE_URL='http://127.0.0.1:8081'

# Optional observability. Keep secrets empty unless Langfuse is enabled.
LANGFUSE_ENABLED='false'
LANGFUSE_HOST=''
LANGFUSE_PUBLIC_KEY=''
LANGFUSE_SECRET_KEY=''
AGENTSCOPE_OBSERVABILITY_ENABLED='true'
AGENTSCOPE_OBSERVABILITY_USE_LANGFUSE_TRACER='true'
